# ======================================================
#  .env.example — sistema-micro-pagos
#  TODAS las variables deben tener PREFIJO por sistema
#  NUNCA usar nombres genéricos: API_URL, DB_HOST, etc.
# ======================================================

# ------------------------------------------------------
#  POSTGRESQL — Datos principales ACID
# ------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=micropay
POSTGRES_USER=app_user
POSTGRES_PASSWORD=cambiar_contraseña_segura_produccion

# ------------------------------------------------------
#  REDIS — Caché + Velocity Counters + Risk Engine
# ------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------
#  SPRING BOOT — Backend Application
# ------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/micropay
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_DATA_REDIS_HOST=${REDIS_HOST}
SPRING_DATA_REDIS_PORT=${REDIS_PORT}

SPRING_JWT_SECRET_KEY=cambiar_por_jwt_secret_minimo_256_bits_base64
SPRING_JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
SPRING_JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
SPRING_JWT_REFRESH_TOKEN_COOKIE_NAME=MICROPAY_REFRESH_TOKEN
SPRING_JWT_ISSUER=micropay-backend

# ------------------------------------------------------
#  STRIPE — Pagos (TopUp + Withdraw + Connect)
#  Usar modo test en dev, live en prod
#  Formato placeholders: [REEMPLAZAME_<TIPO>] para evitar false-positive Secret Scanning GitHub
#  Cuando hagas tu propia copia .env.local:
#    · Publishable key empieza por pk_test_ o pk_live_
#    · Secret key      empieza por sk_test_ o sk_live_
#    · Webhook secret  empieza por whsec_
#    · Connect client  empieza por ca_
# ------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=[REEMPLAZAME_STRIPE_PK]
STRIPE_SECRET_KEY=[REEMPLAZAME_STRIPE_SK]
STRIPE_WEBHOOK_SIGNING_SECRET=[REEMPLAZAME_STRIPE_WHSEC]
STRIPE_CONNECT_CLIENT_ID=[REEMPLAZAME_STRIPE_CONNECT]
STRIPE_ACCOUNT_COUNTRY=CO

# ------------------------------------------------------
#  VITE — Frontend Usuario (Dashboard)
# ------------------------------------------------------
VITE_USER_APP_NAME=MicroPagos
VITE_USER_API_BASE_URL=http://localhost:8080/api/v1
VITE_USER_STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
VITE_USER_DEFAULT_CURRENCY=COP
VITE_USER_DEFAULT_LOCALE=es-CO
VITE_USER_TIMEZONE=America/Bogota

# ------------------------------------------------------
#  VITE — Frontend Admin (Backoffice)
# ------------------------------------------------------
VITE_ADMIN_APP_NAME=MicroPagos Admin
VITE_ADMIN_API_BASE_URL=http://localhost:8080/api/v1
VITE_ADMIN_DEFAULT_LOCALE=es-CO
VITE_ADMIN_TIMEZONE=America/Bogota

# ------------------------------------------------------
#  NGINX — Proxy inverso local
# ------------------------------------------------------
NGINX_LISTEN_PORT=8080
NGINX_BACKEND_UPSTREAM=http://backend:8080
NGINX_FRONTEND_USER_UPSTREAM=http://frontend-user:5173
NGINX_FRONTEND_ADMIN_UPSTREAM=http://frontend-admin:5174

# ------------------------------------------------------
#  PRISM — Mock Server (Sandbox frontend sin backend)
# ------------------------------------------------------
PRISM_MOCK_PORT=4010
PRISM_SPEC_FILE=./docs/openapi/openapi.yaml
