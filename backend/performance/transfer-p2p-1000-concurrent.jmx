<?xml version="1.0" encoding="UTF-8"?>
<!--
=====================================================================
  T14 / T12 JMeter — PLAN DE CARGA P2P 1000 concurrentes A↔B
  Target spec tasks.md:
    • Thread Group 1000 hilos, ramp-up 60s, Loop = 10
    • Transferencias 1 USD alternando Alice→Bob y Bob→Alice
    • Assertions: HTTP 200 OK (SUCCESS) / 409 Conflict (reintentable, se marca success) / 422 BusinessRuleViolation (fallo duro)
    • Listeners: Aggregate Report (contiene p95, p99, throughput) y Summary Report
    • Property 11 (aislamiento concurrencia) + Property 12 (durabilidad) validados después por post-validate.sql

  Ejecución NON-GUI recomendada:
    JMETER=/opt/homebrew/opt/jmeter
    $JMETER/bin/jmeter \
        -n -t backend/performance/transfer-p2p-1000-concurrent.jmx \
        -l backend/performance/results/transfer-p2p.jtl \
        -e -o backend/performance/results/dashboard \
        -Jhost=localhost \
        -Jport=8080 \
        -Jprotocol=http \
        -JseedAmount=1000000 \
        -JtransferAmount=1 \
        -Jthreads=1000 \
        -Jrampup=60 \
        -Jloops=10

  Antes de ejecutar levantar backend con docker compose up backend (o local) y
  crear las extensiones (ya listas en V1).
=====================================================================
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
