        <!-- 1.9 Seeds iniciales Alice / Bob = seedAmount vía UPDATE SQL directo (sin endpoint admin top-up).
               JDBC Request requiere el plugin bzm - JDBC o postgresql jar en lib/.
               Alternativa: descomentar para ejecución con driver Postgres en JMETER_HOME/lib. -->
        <JDBCConnectionConfiguration guiclass="DbConnectionGui" testclass="JDBCConnectionConfiguration" testname="JDBC Config micropay" enabled="false">
          <stringProp name="dataSource">micropay-local</stringProp>
          <stringProp name="dbUrl">jdbc:postgresql://localhost:5432/micropay</stringProp>
          <stringProp name="driver">org.postgresql.Driver</stringProp>
          <stringProp name="username">app_user</stringProp>
          <stringProp name="password">changeme_local_only</stringProp>
        </JDBCConnectionConfiguration>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="Seeds SQL directo Alice/Bob" enabled="false">
          <stringProp name="dataSource">micropay-local</stringProp>
          <stringProp name="query">
UPDATE wallets SET balance = ${__P(seedAmount,1000000)}, reserved = 0, updated_at = NOW()
WHERE id IN ('${__P(ALICE_WALLET_ID,)}', '${__P(BOB_WALLET_ID,)}');
          </stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsValues"></stringProp>
          <stringProp name="queryTypes"></stringProp>
        </JDBCSampler>
        <hashTree/>

      </hashTree>

      <!-- ============================================================
           THREAD GROUP PRINCIPAL: 1000 usuarios concurrentes
           Cada hilo: Loop N veces, alterna transfer A→B y B→A.
           Alternativa de 2 sub grupos (500 hilos cada dirección) descomentando abajo.
           ============================================================ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG A↔B P2P transfers" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__intSum(${threads},0)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__intSum(${rampup},0)}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.delayedStart">true</boolProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__intSum(${loops},0)}</stringProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>

        <!-- Dir A→B (50% hilos) o B→A según threadNum % 2 == 0/1 -->
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Asignar dirección alterna por hilo" enabled="true">
          <stringProp name="cacheKey">dir-allocator</stringProp>
          <stringProp name="ScriptLanguage">groovy</stringProp>
          <stringProp name="Script">
int t = ctx.getThreadNum()
def even = ((t % 2) == 0)
if (even) {
    vars.put(&quot;DIRECTION&quot;, &quot;A2B&quot;)
    vars.put(&quot;AUTH&quot;, props.get(&quot;ALICE_JWT&quot;) ?: &quot;Bearer NO-JWT&quot;)
    vars.put(&quot;FROM&quot;, props.get(&quot;ALICE_WALLET_ID&quot;) ?: &quot;NO-WALLET&quot;)
    vars.put(&quot;TO&quot;,   props.get(&quot;BOB_WALLET_ID&quot;)   ?: &quot;NO-WALLET&quot;)
} else {
    vars.put(&quot;DIRECTION&quot;, &quot;B2A&quot;)
    vars.put(&quot;AUTH&quot;, props.get(&quot;BOB_JWT&quot;) ?: &quot;Bearer NO-JWT&quot;)
    vars.put(&quot;FROM&quot;, props.get(&quot;BOB_WALLET_ID&quot;)   ?: &quot;NO-WALLET&quot;)
    vars.put(&quot;TO&quot;,   props.get(&quot;ALICE_WALLET_ID&quot;) ?: &quot;NO-WALLET&quot;)
}
</stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <!-- Transfer A→B o B→A según DIRECTION -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="transfer ${DIRECTION}" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{
  &quot;wallet_from_id&quot;:&quot;${FROM}&quot;,
  &quot;wallet_to_id&quot;:&quot;${TO}&quot;,
  &quot;amount&quot;:${__P(transferAmount,1)},
  &quot;currency&quot;:&quot;USD&quot;,
  &quot;note&quot;:&quot;JMeter T14 ${DIRECTION} t=${ctx.getThreadNum()} i=${__jm__Loop Controller__idx}&quot;
}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <stringProp name="HTTPSampler.path">${__V(APIV1Path,)}/transactions/transfer</stringProp>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Bearer por hilo">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="Authorization" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">${AUTH}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
        </HTTPSamplerProxy>
        <hashTree>
          <!-- Assert: SUCCESS si 200 o 409 Conflict (Reintento cliente / aceptable)
               FAIL si 422 (regla negocio) o 5xx o 401/403 -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="HTTP 200 ó 409 (conflicto reintentable)" enabled="true">
            <collectionProp name="Asserter.test_strings">
              <stringProp name="Asserter.test_string">200</stringProp>
              <stringProp name="Asserter.test_string">409</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.match_type">12</intProp>
          </ResponseAssertion>
          <hashTree/>

          <!-- 422/5xx marcar error (BRV o servidor down) -->
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="NOT 422 / 401 / 403 / 5xx" enabled="true">
            <collectionProp name="Asserter.test_strings">
              <stringProp name="Asserter.test_string">422</stringProp>
              <stringProp name="Asserter.test_string">401</stringProp>
              <stringProp name="Asserter.test_string">403</stringProp>
              <stringProp name="Asserter.test_string">^5[0-9][0-9]$</stringProp>
            </collectionProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.not">true</boolProp>
            <intProp name="Assertion.match_type">4</intProp>
          </ResponseAssertion>
          <hashTree/>

          <!-- JSON body debe tener status COMPLETED (caso 200) o error_code en 409/422.
               Esta assertion solo se evalúa cuando hubo respuesta. -->
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSON body shape" enabled="true">
            <stringProp name="cacheKey">shape-assert</stringProp>
            <stringProp name="ScriptLanguage">groovy</stringProp>
            <stringProp name="script">
import groovy.json.JsonSlurper
String raw = prev.getResponseDataAsString()
if (!raw) return
try {
    def j = new JsonSlurper().parseText(raw)
    String code = prev.getResponseCode()
    if (code == &quot;200&quot;) {
        if (!j?.status || !j.id || !j.type) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage(&quot;200 response must include status, id, type; got: &quot; + raw.take(200))
        } else if (j.status != &quot;COMPLETED&quot;) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage(&quot;200 response status != COMPLETED: got=&quot; + j.status)
        }
    } else if (code == &quot;409&quot;) {
        if (!j?.error_code || j.error_code.empty) {
            AssertionResult.setFailure(true)
            AssertionResult.setFailureMessage(&quot;409 should include error_code; got: &quot; + raw.take(200))
        }
    }
} catch (Exception ex) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Non-JSON or malformed body: &quot; + ex.message + &quot; - payload=&quot; + raw.take(200))
}
</stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>

        <!-- Rate limit 1 req/s máximo no activado; espec T12 ≥ 120 tps global.
             Añade ConstantTimer si deseas limitar por hilo. -->
      </hashTree>

      <!-- ============================================================
           LISTENERS: throughput + p95 + p99 + errors
           ============================================================ -->
      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>false</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>false</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename"></stringProp>
      </ResultCollector>
      <hashTree/>

      <ResultCollector guiclass="StatGraphVisualizer" testclass="ResultCollector" testname="Aggregate Report (p95/p99)" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
            <success>true</success>
            <label>true</label>
            <code>true</code>
            <message>true</message>
            <threadName>true</threadName>
            <dataType>true</dataType>
            <encoding>false</encoding>
            <assertions>true</assertions>
            <subresults>false</subresults>
            <responseData>false</responseData>
            <samplerData>false</samplerData>
            <xml>false</xml>
            <fieldNames>true</fieldNames>
            <responseHeaders>false</responseHeaders>
            <requestHeaders>false</requestHeaders>
            <responseDataOnError>false</responseDataOnError>
            <saveAssertionResultsFailureMessage>true</saveAssertionResultsFailureMessage>
            <assertionsResultsToSave>0</assertionsResultsToSave>
            <bytes>true</bytes>
            <sentBytes>true</sentBytes>
            <url>true</url>
            <threadCounts>true</threadCounts>
            <idleTime>true</idleTime>
            <connectTime>true</connectTime>
          </value>
        </objProp>
        <stringProp name="filename">backend/performance/results/aggregate.jtl</stringProp>
      </ResultCollector>
      <hashTree/>

      <BackendListener guiclass="BackendListenerGui" testclass="BackendListener" testname="Backend Listener (InfluxDb opcional)" enabled="false">
        <elementProp name="arguments" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
          <collectionProp name="Arguments.arguments">
            <elementProp name="influxdbMetricsSender" elementType="Argument">
              <stringProp name="Argument.name">influxdbMetricsSender</stringProp>
              <stringProp name="Argument.value">org.apache.jmeter.visualizers.backend.influxdb.InfluxdbMetricsSender</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="influxdbUrl" elementType="Argument">
              <stringProp name="Argument.name">influxdbUrl</stringProp>
              <stringProp name="Argument.value">http://localhost:8086/write?db=jmeter</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="application" elementType="Argument">
              <stringProp name="Argument.name">application</stringProp>
              <stringProp name="Argument.value">micropay-t14</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
            <elementProp name="measurement" elementType="Argument">
              <stringProp name="Argument.name">measurement</stringProp>
              <stringProp name="Argument.value">jmeter</stringProp>
              <stringProp name="Argument.metadata">=</stringProp>
            </elementProp>
          </collectionProp>
        </elementProp>
        <stringProp name="classname">org.apache.jmeter.visualizers.backend.influxdb.InfluxdbBackendListenerClient</stringProp>
        <stringProp name="queueSize"></stringProp>
      </BackendListener>
      <hashTree/>

    </hashTree>
  </hashTree>
</jmeterTestPlan>
