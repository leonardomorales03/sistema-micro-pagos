            <stringProp name="script">
import groovy.json.JsonSlurper
if (prev.isSuccessful() &amp;&amp; [201,409].contains(prev.getResponseCode() as int)) {
    if (prev.getResponseDataAsString()) {
        def j = new JsonSlurper().parseText(prev.getResponseDataAsString())
        if (j?.id) props.put(&quot;ALICE_USER_ID&quot;, j.id as String)
    }
}
</stringProp>
